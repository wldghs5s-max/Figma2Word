{
  "name": "figma2word",
  "version": "0.1.0",
  "description": "Figma design to Microsoft Word (.docx) local conversion engine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "convert": "tsx src/cli.ts",
    "convert:url": "tsx src/cli.ts --url",
    "generate-fixtures": "tsx src/fixtures/generate.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build"
  },
  "keywords": ["figma", "docx", "word", "document-converter"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "docx": "^9.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
